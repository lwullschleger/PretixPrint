{
  "name": "pretix-print-service",
  "version": "1.2.0",
  "description": "Automatically print tickets when checking in with Pretix",
  "author": "Luca Wullschleger",
  "main": "electron.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "pdf-lib": "^1.17.1",
    "pdf-to-printer": "^5.6.0",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.pretix.gateprint",
    "productName": "Pretix Print Service",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "files": [
      "electron.js",
      "preload.js",
      "launch.js",
      "server/**/*",
      "renderer/**/*"
    ]
  }
}
